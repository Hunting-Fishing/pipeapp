root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{dart,js,mjs,cjs,json,md,yml,yaml,html,css,svg}]
end_of_line = lf

[*.ps1]
end_of_line = crlf

[*.dart]
indent_style = space
indent_size = 2

[*.{js,mjs,cjs,json,yml,yaml}]
indent_style = space
indent_size = 2
