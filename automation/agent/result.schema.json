{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Autonomous Build Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "task",
    "source_doc",
    "source_item",
    "summary",
    "changed_files",
    "knowledge_used",
    "risk_level",
    "risk_reasons",
    "refactor_mode",
    "compatibility_notes",
    "compatibility_checks",
    "data_change",
    "data_change_notes",
    "dependency_change",
    "dependency_change_notes",
    "provider_change",
    "provider_change_notes",
    "security_change",
    "security_change_notes",
    "billing_change",
    "billing_change_notes",
    "rollback_notes",
    "verification",
    "requires_human",
    "blocker_classification",
    "human_reason",
    "next_task",
    "commit_message"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["continue", "blocked", "complete"]
    },
    "task": { "type": "string" },
    "source_doc": { "type": "string" },
    "source_item": { "type": "string" },
    "summary": { "type": "string" },
    "changed_files": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "knowledge_used": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "risk_reasons": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "refactor_mode": {
      "type": "string",
      "enum": ["none", "behavior-preserving", "behavior-changing"]
    },
    "compatibility_notes": { "type": "string" },
    "compatibility_checks": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "data_change": { "type": "boolean" },
    "data_change_notes": { "type": "string" },
    "dependency_change": { "type": "boolean" },
    "dependency_change_notes": { "type": "string" },
    "provider_change": { "type": "boolean" },
    "provider_change_notes": { "type": "string" },
    "security_change": { "type": "boolean" },
    "security_change_notes": { "type": "string" },
    "billing_change": { "type": "boolean" },
    "billing_change_notes": { "type": "string" },
    "rollback_notes": { "type": "string" },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "result", "evidence"],
        "properties": {
          "command": { "type": "string" },
          "result": {
            "type": "string",
            "enum": ["passed", "failed", "not-run"]
          },
          "evidence": { "type": "string" }
        }
      }
    },
    "requires_human": { "type": "boolean" },
    "blocker_classification": {
      "type": "string",
      "enum": [
        "none",
        "external-toolchain",
        "credentials",
        "provider-dashboard",
        "production",
        "legal-tax",
        "ambiguous-policy",
        "security",
        "data-risk",
        "financial-risk",
        "release-risk",
        "knowledge-conflict"
      ]
    },
    "human_reason": { "type": "string" },
    "next_task": { "type": "string" },
    "commit_message": { "type": "string" }
  }
}
