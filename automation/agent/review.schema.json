{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Autonomous Independent Review Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "risk_level",
    "summary",
    "findings",
    "functionality_loss_risk",
    "security_risk",
    "data_integrity_risk",
    "billing_financial_risk",
    "architecture_drift_risk",
    "design_drift_risk",
    "missing_tests",
    "knowledge_conflicts",
    "human_review_focus"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["pass", "block"]
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "category", "file", "evidence", "required_fix"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["info", "warning", "error", "critical"]
          },
          "category": {
            "type": "string",
            "enum": [
              "regression",
              "functionality-loss",
              "security",
              "privacy",
              "data",
              "billing",
              "provider",
              "architecture",
              "design",
              "accessibility",
              "performance",
              "cost",
              "testing",
              "documentation",
              "release",
              "dependency",
              "other"
            ]
          },
          "file": { "type": "string" },
          "evidence": { "type": "string" },
          "required_fix": { "type": "string" }
        }
      }
    },
    "functionality_loss_risk": { "type": "string" },
    "security_risk": { "type": "string" },
    "data_integrity_risk": { "type": "string" },
    "billing_financial_risk": { "type": "string" },
    "architecture_drift_risk": { "type": "string" },
    "design_drift_risk": { "type": "string" },
    "missing_tests": {
      "type": "array",
      "items": { "type": "string" }
    },
    "knowledge_conflicts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "human_review_focus": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
