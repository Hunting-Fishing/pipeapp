{
  "schema_version": 1,
  "critical_changes_allowed": false,
  "documentation_max_lines": 600,
  "forbidden_path_patterns": [
    "(^|/)\\.env($|\\.)",
    "service[-_]?account.*\\.json$",
    "credentials?.*\\.json$",
    "secrets?/",
    "private[-_]?key"
  ],
  "secret_content_patterns": [
    "-----BEGIN (RSA |EC |OPENSSH |)?PRIVATE KEY-----",
    "sk_live_[A-Za-z0-9]{16,}",
    "gh[pousr]_[A-Za-z0-9]{20,}",
    "sk-proj-[A-Za-z0-9_-]{20,}"
  ],
  "path_risk_rules": [
    {
      "risk": "high",
      "pattern": "(^|/)server/|(^|/)api/|(^|/)functions/",
      "reason": "server-authoritative behavior"
    },
    {
      "risk": "high",
      "pattern": "auth|permission|security|rules",
      "reason": "security/authorization behavior"
    },
    {
      "risk": "high",
      "pattern": "payment|billing|invoice|refund|tax",
      "reason": "financial/billing behavior"
    },
    {
      "risk": "high",
      "pattern": "migration|schema|backfill",
      "reason": "persisted data behavior"
    },
    {
      "risk": "high",
      "pattern": "package\\.json$|package-lock\\.json$|pubspec\\.ya?ml$|pubspec\\.lock$",
      "reason": "dependency/toolchain change"
    },
    {
      "risk": "high",
      "pattern": "(^|/)\\.github/workflows/|deploy|release",
      "reason": "CI/release behavior"
    },
    {
      "risk": "medium",
      "pattern": "(^|/)src/|(^|/)lib/|(^|/)app/|(^|/)test/",
      "reason": "application behavior/regression surface"
    }
  ],
  "dependency_path_patterns": [
    "package\\.json$",
    "package-lock\\.json$",
    "pubspec\\.ya?ml$",
    "pubspec\\.lock$"
  ],
  "data_path_patterns": [
    "schema",
    "migration",
    "backfill",
    "database"
  ],
  "security_path_patterns": [
    "auth",
    "permission",
    "security",
    "rules"
  ],
  "billing_path_patterns": [
    "payment",
    "billing",
    "invoice",
    "refund",
    "tax"
  ],
  "provider_path_patterns": [
    "provider",
    "webhook",
    "oauth",
    "routing",
    "messaging"
  ]
}
