    },
    {
      "path": "firebase/functions/index.js",
      "pattern": "exports.manageWantedMatch = onCall("
    },
    {
      "path": "firebase/functions/bootstrap.js",
      "pattern": "exports.createMarketplaceCheckout = onCall("
    },
    {
      "path": "firebase/functions/bootstrap.js",
      "pattern": "exports.createExternalSettlementFeeCheckout = onCall("
    },
    {
      "path": "firebase/functions/bootstrap.js",
      "pattern": "exports.createDispatchSubscriptionCheckout = onCall("
    },
    {
      "path": "firebase/functions/bootstrap.js",
      "pattern": "exports.stripeMarketplaceWebhook = onRequest("
