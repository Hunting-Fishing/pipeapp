    },
    {
      "path": "lib/flutter_flow/nav/nav.dart",
      "pattern": "path: '/conversations/:conversationId'"
    },
    {
      "path": "lib/flutter_flow/nav/nav.dart",
      "pattern": "path: '/dispatch/jobs/:jobId'"
    },
    {
      "path": "firebase/functions/package.json",
