rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && 'admin' in request.auth.token
        && 'role' in request.auth.token
        && 'firebase' in request.auth.token
        && 'sign_in_second_factor' in request.auth.token.firebase
        && request.auth.token.admin == true
        && request.auth.token.role == 'administrator'
        && request.auth.token.firebase.sign_in_second_factor is string
        && request.auth.token.firebase.sign_in_second_factor.size() > 0;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isVideo() {
      return request.resource.contentType.matches('video/.*');
    }

    function validUploadAuthorization(fileName, userId, purpose, targetId) {
      let authorization = firestore.get(
        /databases/(default)/documents/media_upload_authorizations/$(fileName)
      ).data;
      return isOwner(userId)
        && authorization.ownerUid == userId
        && authorization.purpose == purpose
        && authorization.targetId == targetId
        && authorization.status == 'authorized'
        && authorization.expiresAt > request.time
        && authorization.contentType == request.resource.contentType
        && authorization.sizeBytes == request.resource.size;
    }

    match /listing_media/{userId}/{listingId}/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(userId)
        && request.resource.size <= 25 * 1024 * 1024
        && (isImage() || isVideo());
      allow delete: if isOwner(userId);
    }

    match /profile_media/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(userId)
        && request.resource.size <= 10 * 1024 * 1024
        && isImage();
      allow delete: if isOwner(userId);
    }

    match /business_documents/{userId}/{fileName} {
      allow read, create, update, delete: if isOwner(userId)
        && (request.method == 'delete'
          || request.resource.size <= 15 * 1024 * 1024);
    }

    match /chat_attachments/{conversationId}/{userId}/{fileName} {
      function isConversationMember() {
        return signedIn()
          && request.auth.uid in firestore.get(
            /databases/(default)/documents/conversations/$(conversationId)
          ).data.memberUids;
      }
      allow read: if isConversationMember();
      allow create: if validUploadAuthorization(
          fileName, userId, 'chat_attachment', conversationId)
        && isConversationMember()
        && request.resource.size <= 15 * 1024 * 1024
        && (isImage() || isVideo()
          || request.resource.contentType == 'application/pdf');
      allow update: if false;
      allow delete: if isOwner(userId) && isConversationMember();
    }

    match /report_evidence/{userId}/{reportId}/{fileName} {
      allow create: if validUploadAuthorization(
          fileName, userId, 'report_evidence', reportId)
        && request.resource.size <= 10 * 1024 * 1024
        && isImage();
      allow read: if signedIn() && (
        isOwner(userId) ||
        isAdmin()
      );
      allow update: if false;
      allow delete: if isOwner(userId) || isAdmin();
    }
  }
}
