gha-creds-*.json

# Local secrets and environment overrides
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx

# Codex recovery archives are intentionally outside the app source tree
.codex-backups/

# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini

# Local editor extension package
*.vsix
