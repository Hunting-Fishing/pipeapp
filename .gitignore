# Flutter and Dart generated state
.dart_tool/
.packages
.pub/
.flutter-plugins
.flutter-plugins-dependencies
build/
coverage/
**/ephemeral/

# IDE-local state
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# Local runtime and diagnostic output
*.log
.tmp/
.playwright-mcp/

# Firebase local/generated state
.firebase/
.firebaserc
firebase/public/
firebase/functions/node_modules/
firebase/agent-functions/node_modules/
firebase/rules-tests/node_modules/
